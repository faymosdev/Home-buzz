# Copy to .env.local for local development, and set the same variables in your hosting provider.

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.co.uk

# ── Supabase (quote requests, contact messages, photo storage) ───────────────
# Project Settings → API. Without all three, the forms show an honest
# "online requests aren't switched on yet" message instead of pretending to send.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to "quote-photos" (created by the migration).
NEXT_PUBLIC_SUPABASE_QUOTE_PHOTOS_BUCKET=quote-photos

# ── Email notifications via Resend (optional) ────────────────────────────────
# Without these, enquiries are still saved to Supabase; no email is sent.
RESEND_API_KEY=
# Where new-enquiry notifications go (comma-separate multiple addresses).
NOTIFY_EMAIL_TO=
# Must be on a domain verified in Resend, e.g. "Homebuzz Website <quotes@yourdomain.co.uk>"
NOTIFY_EMAIL_FROM=
